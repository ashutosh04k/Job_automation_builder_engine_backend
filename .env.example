# ---- Required ----
PORT=5001
MONGO_URI=mongodb+srv://USER:PASS@cluster/resume_cron_db
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

API_BASE_URL=https://resume-backend-api-pvx4.onrender.com
CORS_ORIGINS=https://resume-automation-app-adyg.onrender.com,http://localhost:5173

# ---- Admin seeding (first boot only) ----
PRIMARY_USER_EMAIL=
PRIMARY_USER_PASSWORD=
PRIMARY_USER_NAME=

# ---- Email (Gmail API via OAuth2) ----
SENDER_NAME=
SENDER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- Daily dispatch ----
ENABLE_CRON=true
CRON_SCHEDULE=0 9 * * *
CRON_TZ=Asia/Kolkata
DAILY_SEND_LIMIT=15
SEND_DELAY_MS=20000
